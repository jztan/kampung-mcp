# Copy to .env and edit. .env is optional: the server starts without it.
# Never commit .env (it is gitignored and dockerignored).

# Host port the server is published on, on 127.0.0.1 only.
KAMPUNG_HOST_PORT=8803

# Image tag for ghcr.io/jztan/kampung-mcp: a release such as 0.1.0, or
# latest. `docker compose pull` fetches it; `up --build` builds this checkout
# under that tag instead.
KAMPUNG_IMAGE_TAG=latest

# Public hostname for the optional Caddy service (docker compose --profile tls).
# Caddy gets a certificate for it automatically. Required for that profile.
KAMPUNG_DOMAIN=kampung.example.com

# Admin dashboard at /admin. Unset means the dashboard is off. At least 24
# characters, e.g. the output of: openssl rand -hex 24
# KAMPUNG_ADMIN_TOKEN=

# Public https address of this server: lowercase host, no port, path or
# trailing slash.
# Setting it turns on the Claude app connector (OAuth at this address, the
# connector URL is this plus /mcp). Unset means no OAuth routes exist.
# KAMPUNG_PUBLIC_URL=https://kampung.example.com

# Which peers may set the client address through X-Forwarded-For. The
# default "*" is right for the bundled Caddy (which replaces the header) with
# the port published on loopback. Behind a proxy that appends to the header
# instead, set its address here, or clients can pick their own. Without
# Caddy (Tailscale only, see docs/server.md), set 127.0.0.1: no outside client
# connects from there, so the header is trusted from nobody. An empty value
# falls back to "*".
# KAMPUNG_FORWARDED_ALLOW_IPS=*

# KAMPUNG_HTTP_HOST, KAMPUNG_HTTP_PORT and KAMPUNG_DB_PATH are pinned by
# docker-compose.yml, so setting them here has no effect.

# Loop guard. Two mailboxes may wake each other KAMPUNG_PAIR_WAKE_SIZE times
# in a row, and get one wake back every KAMPUNG_PAIR_WAKE_REFILL_MINUTES. A
# mailbox may wake peers KAMPUNG_MAILBOX_WAKE_BUDGET times until someone
# types in one of its sessions. A waking message from the Claude app refills
# the mailbox it reaches, at most once per
# KAMPUNG_CONNECTOR_REFILL_COOLDOWN_MINUTES. The Claude app may wake one
# mailbox KAMPUNG_CONNECTOR_WAKE_BUDGET times per 10 minutes; it is never
# woken itself, so this only stops a runaway app turn. Mail past a budget still
# arrives; it just does not wake anyone. A value out of range stops the server.
# A changed refill interval applies from the next start: pairs drained under a
# longer one owe at most KAMPUNG_PAIR_WAKE_SIZE of the new intervals.
# KAMPUNG_PAIR_WAKE_SIZE=9
# KAMPUNG_PAIR_WAKE_REFILL_MINUTES=10
# KAMPUNG_MAILBOX_WAKE_BUDGET=30
# KAMPUNG_CONNECTOR_REFILL_COOLDOWN_MINUTES=10
# KAMPUNG_CONNECTOR_WAKE_BUDGET=60
