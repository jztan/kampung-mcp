# Copy to .env and edit. .env is optional: the server starts without it.
# Never commit .env (it is gitignored and dockerignored).

# Host port the server is published on, on 127.0.0.1 only.
KAMPUNG_HOST_PORT=8803

# Image tag for ghcr.io/jztan/kampung-mcp. Until the image is published,
# compose builds it locally and this only names the local build.
KAMPUNG_IMAGE_TAG=latest

# Public hostname for the optional Caddy service (docker compose --profile tls).
# Caddy gets a certificate for it automatically. Required for that profile.
KAMPUNG_DOMAIN=kampung.example.com

# Admin dashboard at /admin. Unset means the dashboard is off. At least 24
# characters, e.g. the output of: openssl rand -hex 24
# KAMPUNG_ADMIN_TOKEN=

# KAMPUNG_HTTP_HOST, KAMPUNG_HTTP_PORT and KAMPUNG_DB_PATH are pinned by
# docker-compose.yml, so setting them here has no effect.
