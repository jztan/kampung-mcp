{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jztan/kampung-mcp",
  "description": "Messaging between coding-agent sessions on different machines, through a server you host.",
  "repository": {
    "url": "https://github.com/jztan/kampung-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "kampung-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "adapter"
        }
      ]
    }
  ]
}
